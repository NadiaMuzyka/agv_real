%%{init: {"state": {"rankSpacing": 100, "nodeSpacing": 100}}}%%
graph TD
    %% ==========================================
    %% DEFINIZIONE DEGLI STATI (Nodi)
    %% ==========================================
    START((Inizio))
    
    IDLE([IDLE])
    NODE([NODE_STATE])
    MANEUVER([MANEUVERING_STATE])
    REVERSE([REVERSING_STATE])
    FOLLOW([FOLLOWING_STATE])
    TARGET([TARGET_NODE_STATE])
    ERR([ERROR_STATE])

    %% ==========================================
    %% ARCHI USCENTI DA: START
    %% ==========================================
    START ---> IDLE

    %% ==========================================
    %% ARCHI USCENTI DA: IDLE
    %% ==========================================
    IDLE -->|c_t==STOP| IDLE
    IDLE --->|am_in_a_node| NODE
    IDLE --->|c_t==MOVE_TO & !am_in_a_node| FOLLOW

    %% ==========================================
    %% ARCHI USCENTI DA: NODE_STATE
    %% ==========================================
    NODE --->|c_t==MOVE_TO & next_node!=target_node| MANEUVER
    NODE --->|c_t==MOVE_TO & next_node==target_node| REVERSE
    NODE -.->|c_t==STOP| IDLE
    NODE -.->|c_t==PICKUP / DROP| ERR

    %% ==========================================
    %% ARCHI USCENTI DA: FOLLOWING_STATE
    %% ==========================================
    FOLLOW -->|c_t==MOVE_TO & !am_in_a_node| FOLLOW
    FOLLOW --->|am_in_a_node| NODE
    FOLLOW -.->|c_t==STOP| IDLE
    FOLLOW -.->|c_t==PICKUP / c_t==DROP| ERR

    %% ==========================================
    %% ARCHI USCENTI DA: MANEUVERING_STATE
    %% ==========================================
    MANEUVER -..->|manuuver_state==compleated| IDLE

    %% ==========================================
    %% ARCHI USCENTI DA: REVERSING_STATE
    %% ==========================================
    REVERSE --->|am_in_a_node & current_node==target_node| TARGET